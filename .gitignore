# ---------- 运行产物 ----------
server/bridge.log
__pycache__/
*.pyc

# ---------- 临时验证文件（统一放 _t/，不要再散落在根目录） ----------
# 无头浏览器、探针页、临时脚本一律以 _ 开头，且必须被忽略，避免误提交
_t/
_tmp*/
_test/
_*.png
_*.py
_*.html
_*.stl
_*.ply
*.tmp

# ---------- 本地测试数据 ----------
# data/ 里放的是自备样例（如 Stanford Bunny），单份常达数 MB，不入库。
# 需要给 Pages / README 用的演示数据请放 docs/samples/（体积控制在 1~2 MB）。
data/

# ---------- 编辑器 / IDE ----------
.codebuddy/
.idea/
.vscode/
*.swp

# ---------- 系统文件 ----------
Thumbs.db
desktop.ini
.DS_Store
